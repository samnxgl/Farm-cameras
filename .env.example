# ===========================================
# Multi-Camera Detection System Configuration
# ===========================================

# -------------------------------------------
# Camera 1: Farm Camera (animals & vehicles)
# -------------------------------------------
# You can use legacy HIKVISION_* variables or the new CAMERA_1_* format
HIKVISION_IP=192.168.1.100
HIKVISION_PORT=80
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=your_camera_password
HIKVISION_CHANNEL=1

# Or use the new format:
# CAMERA_1_NAME=Farm Camera
# CAMERA_1_IP=192.168.1.100
# CAMERA_1_PORT=80
# CAMERA_1_USERNAME=admin
# CAMERA_1_PASSWORD=your_camera_password
# CAMERA_1_CHANNEL=1
# CAMERA_1_PROFILE=farm
# CAMERA_1_ENABLED=true

# -------------------------------------------
# Camera 2: Home Entrance (people, cars, animals)
# -------------------------------------------
# Option A: Use RTSP stream directly (recommended for remote cameras)
# CAMERA_2_NAME=Home Entrance
# CAMERA_2_RTSP_URL=rtsp://your-camera-address:554/streaming/channels/101
# CAMERA_2_USERNAME=admin
# CAMERA_2_PASSWORD=your_password
# CAMERA_2_PROFILE=entrance
# CAMERA_2_ENABLED=true

# Option B: Use HTTP ISAPI (for local Hikvision cameras)
# CAMERA_2_NAME=Home Entrance
# CAMERA_2_IP=192.168.1.101
# CAMERA_2_PORT=80
# CAMERA_2_USERNAME=admin
# CAMERA_2_PASSWORD=your_camera_password
# CAMERA_2_CHANNEL=1
# CAMERA_2_PROFILE=entrance
# CAMERA_2_ENABLED=true

# -------------------------------------------
# Camera 3: Additional camera (optional)
# -------------------------------------------
# CAMERA_3_NAME=Backyard
# CAMERA_3_IP=192.168.1.102
# CAMERA_3_PORT=80
# CAMERA_3_USERNAME=admin
# CAMERA_3_PASSWORD=your_camera_password
# CAMERA_3_CHANNEL=1
# CAMERA_3_PROFILE=farm
# CAMERA_3_ENABLED=true

# -------------------------------------------
# Detection Profiles
# -------------------------------------------
# farm     - Detects animals and vehicles (for farm/field cameras)
# entrance - Detects people, vehicles, and animals with detailed descriptions
#            (for entrance/doorbell cameras)

# -------------------------------------------
# Anthropic API (for AI detection)
# -------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key

# -------------------------------------------
# Slack Configuration
# -------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#farm-alerts

# -------------------------------------------
# Application Settings
# -------------------------------------------
CAPTURE_INTERVAL_SECONDS=10
SAVE_IMAGES=true
IMAGES_DIR=./captured_images
